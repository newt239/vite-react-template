{
  "name": "vite-react-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "codecheck": "pnpm run typecheck && pnpm run lint && pnpm run format && pnpm run knip && pnpm run test",
    "dev": "vp dev",
    "format": "vp fmt --check",
    "format:fix": "vp fmt",
    "knip": "knip",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "preinstall": "npx only-allow pnpm",
    "preview": "vp preview",
    "test": "vp test run",
    "test:watch": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "knip": "6.38.0",
    "lefthook": "2.1.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-plus": "1.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.11.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1"
}
