{
  "extends": "./.void/tsconfig.json", // void prepare が生成する @schema などのパス・型定義を読み込む
  "compilerOptions": {
    "incremental": true,
    "target": "esnext",
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "#/*": ["./src/*"],
      // paths は extends 元とマージされないため、.void/tsconfig.json の定義をここにも書く
      "@schema": ["./db/schema.ts"],
      "@schema/*": ["./db/schema/*"],
      "void/db": ["./.void/db.d.ts"],
      "void/routes": ["./.void/routes.d.ts"],
      "vite": ["./node_modules/vite-plus/dist/index.d.ts"] // @vitejs/plugin-react の Plugin 型を vite-plus と同一宣言に解決する
    },
    "types": ["node", "void/env"],
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true, // ファイル名の大文字・小文字の不一致によるバグを防ぐ
    "noUncheckedIndexedAccess": true, // インデックスアクセスの型安全を強制
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests", "routes", "db", "vite.config.ts", "void.config.ts"],
  "exclude": ["node_modules"]
}
